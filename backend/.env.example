# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server
PORT=5000
NODE_ENV=development

# CORS – list every browser origin allowed to call this API.
# Must match the Flutter dev-server port (see README).
CORS_ORIGIN=http://localhost:3000

# Public URL of the Flutter web app. Used to build the redirect links that
# Supabase appends its token to. Leave unset in local development and the
# backend falls back to the request's Origin header.
# FRONTEND_URL=https://your-domain.com

# ── Email confirmation ───────────────────────────────────────────────────────
# true  = mark the address confirmed immediately using the service-role key.
#         No confirmation email is sent, so signup cannot hit Supabase's
#         email rate limit (the free tier only sends a few per hour).
#         Signup returns a session, so the user lands on the homepage already
#         signed in.
# false = send a confirmation email. The user must click the link before
#         they can sign in. Needs working SMTP — otherwise signup fails with
#         "email rate limit exceeded".
#
# Recommended: true while developing, false once you configure a real
# SMTP provider for the demo.
AUTO_CONFIRM_EMAIL=true

# JWT Secret (for custom token signing if needed)
JWT_SECRET=your-very-strong-secret-key-here